# Copy to .env and fill in. Never commit the real .env.

# Stage 4 - Gemini vision (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Set to false to run the pipeline without any Gemini calls (motion + YOLO only)
CM_GEMINI_ENABLED=true

# Vision model. Rolling aliases work on new API keys; pinned ids like
# "gemini-2.0-flash" return 429 (limit: 0) unless the project has quota for them.
# CM_GEMINI_MODEL=gemini-flash-lite-latest

# Path to adb if it is not on PATH
# CM_ADB_PATH=C:\Android\Sdk\platform-tools\adb.exe

# Capture cadence in seconds (1-2 recommended)
CM_CAPTURE_INTERVAL=1.5

# Cost control
CM_GEMINI_COOLDOWN=30
CM_GEMINI_MAX_CALLS_PER_HOUR=150

# CPU tuning
CM_TORCH_THREADS=2
